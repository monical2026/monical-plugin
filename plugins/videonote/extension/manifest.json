{
  "manifest_version": 3,
  "name": "VideoNote",
  "version": "0.9.8",
  "description": "带时间的双语逐字稿、中文梳理和可编辑学习笔记。",
  "permissions": [
    "storage",
    "downloads",
    "clipboardWrite",
    "nativeMessaging",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 VideoNote",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "capture-note": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "摘录当前视频片段并记笔记"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "bilibili-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "assets/*"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.bilibili.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "minimum_chrome_version": "114"
}
